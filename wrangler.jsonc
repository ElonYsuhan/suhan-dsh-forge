{
  // 静态资源部署配置（Workers Static Assets）。
  // 显式提供配置可让 wrangler 跳过自动配置流程，避免在 pnpm
  // 工作区中触发 npm install（catalog: 协议不受 npm 支持）。
  "name": "suhan-dsh-forge",
  "compatibility_date": "2026-08-16",
  "observability": {
    "enabled": true
  },
  "assets": {
    "directory": "apps/marketplace/dist",
    "not_found_handling": "single-page-application"
  }
}
