{
  "name": "suhan-dsh-forge",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.9.0",
  "engines": {
    "node": "^22.19.0 || >=24.0.0"
  },
  "scripts": {
    "build": "pnpm --recursive --if-present run build",
    "check": "pnpm run validate && pnpm run lint && pnpm run typecheck && pnpm run test && pnpm run build && pnpm run pack:check",
    "dev:marketplace": "pnpm --filter @suhan-dsh/marketplace dev",
    "dsh:plugin": "node scripts/manage-dsh-plugin.mjs",
    "dsh:plugin:install": "node scripts/manage-dsh-plugin.mjs install",
    "dsh:plugin:uninstall": "node scripts/manage-dsh-plugin.mjs uninstall",
    "dsh:restart": "node scripts/restart-dsh.mjs restart",
    "dsh:start": "node scripts/restart-dsh.mjs start",
    "dsh:stop": "node scripts/restart-dsh.mjs stop",
    "lint": "pnpm --recursive --if-present run lint",
    "pack:check": "pnpm --recursive --if-present run pack:check",
    "test": "pnpm --recursive --if-present run test",
    "typecheck": "pnpm --recursive --if-present run typecheck",
    "validate": "node scripts/validate-plugins.mjs"
  }
}
